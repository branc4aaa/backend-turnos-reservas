<section>
    <div>
        <h1>Reservas</h1>
        <ul>
            {{#each bookings}}
            <li>
                <h2>{{this.clientName}}</h2>
                <p>Fecha: {{this.date}}</p>
                <p>Hora: {{this.time}}</p>
                <p>Servicios:</p>
                {{#each this.services}}
                    <li>
                        {{service.name}}
                        -
                        ${{service.price}}
                        -
                        Cantidad: {{quantity}}
                    </li>
                {{/each}}
            </li>
            {{/each}}
        </ul>
    </div>
</section>