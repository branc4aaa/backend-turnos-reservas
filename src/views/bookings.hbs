<section>
    <div>
        <h1>Reservas</h1>
        <ul>
            {{#each bookings}}
            <li>
                <h2>{{this.clientName}}</h2>
                <p>Fecha: {{this.date}}</p>
                <p>Hora: {{this.time}}</p>
                <p>Servicios:</p>
                <ul>
                    {{#each this.services}}
                    <li>{{this.name}} - ${{this.price}}</li>
                    {{/each}}
                </ul>
            </li>
            {{/each}}
        </ul>
    </div>
</section>