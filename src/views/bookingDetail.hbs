<section>
    <div>
        <h1>Detalle de la Reserva</h1>
        <h2>{{booking.clientName}}</h2>
        <p>Fecha: {{booking.date}}</p>
        <p>Hora: {{booking.time}}</p>
        <p>Servicios:</p>
        {{#each booking.services}}
            <li>
                {{service.name}}
                -
                ${{service.price}}
                -
                Cantidad: {{quantity}}
            </li>
        {{/each}}
    </div>
</section>